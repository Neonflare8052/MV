"""s14 · 2:42.632–2:57.246  the mirrored chorus: punched cards, history run backwards.
The first chorus gave "you" everything; this one gives "them" the EXECUTION. One material throughout: the punched card —
which counted and sorted people (the 1939 German census, on Hollerith machines), which Turing's generation grew up
beside, and which began in 1804 by weaving flowers. "If I can have you back" winds history back toward that loom.

If I can            the blood of the last shot is the light behind a card: its holes glow red in the dark; lit, it is
                    a census card, VOLKSZÄHLUNG 17. MAI 1939, columns down to Abstammung.
give them all the   pulling back: ring after ring of cards (the first chorus's spiral of windows, mirrored) — thousands,
                    each a person with a different pattern of holes and no face.
EXECUTION           one hole is punched in every card at once, the same place: the Abstammung column. It glows red.
Then I can be your only   the rings are thrown outward, outer ones first; the centre card is left alone.
EXECUTION           the centre card: its red hole pulses.
If I can have you back   13. II. 1930. The cards come back — as a drum of 24 around it, one missing (C. M. 1911–1930).
                    Turing: "spirit is really eternally connected with matter" (Nature of Spirit, c. 1932).
I will run the EXECUTION   the drum spins, faster, and stops; the gap is still there.
Though we are trapped   into the red hole: inside, the warp threads of a loom stand like bars.
We are trapped ah   1843. The weft goes in row by row and weaves a red flower round a ring with a gap.
                    Lovelace: the Analytical Engine weaves algebraical patterns as the Jacquard loom weaves flowers."""
import math
from PIL import Image, ImageDraw, ImageFont

T0, T1, T2 = 162.632, 163.315, 165.166
T3, T3B, T4 = 166.016, 167.022, 168.911
T5, T6, T7 = 169.824, 171.868, 172.712
T8, T9, TE = 173.643, 174.975, 177.246

CW, CH = .3, .132                       # a card (7 3/8 x 3 1/4 in)
COLW, ROWH = .93 / 80, .70 / 12
MARK = (64, 3)                          # Abstammung, row "1"
HOLEC = ((.035 + (MARK[0] + .5) * COLW - .5) * CW, (.80 - (MARK[1] + .5) * ROWH - .5) * CH)
HOLEH = (.2 * COLW * CW, .3 * ROWH * CH)
ZF = (16 / 9) / (2 * HOLEH[0] * .95)    # inside the hole
GROUPS = ['Geburtsjahr', 'Geschlecht', 'Familienstand', 'Beruf', 'Religion', 'Muttersprache', 'Abstammung', 'Gemeinde']
FONT = 'C:/Windows/Fonts/cour.ttf'
FONTB = 'C:/Windows/Fonts/courbd.ttf'


def _face():
    W, H = 2048, 900
    img = Image.new('L', (W, H), 0); d = ImageDraw.Draw(img)
    px = lambda u: u * W
    py = lambda v: (1 - v) * H
    fd = ImageFont.truetype(FONT, 26)
    for i in range(2, 12):
        for j in range(80):
            x, y = px(.035 + (j + .5) * COLW), py(.80 - (i + .5) * ROWH)
            d.text((x, y), str(i - 2), font=fd, fill=200, anchor='mm')
    fs = ImageFont.truetype(FONT, 21)
    for g, name in enumerate(GROUPS):
        x0, x1 = px(.035 + g * 10 * COLW), px(.035 + (g + 1) * 10 * COLW)
        d.text(((x0 + x1) / 2, py(.855)), name, font=fs, fill=235, anchor='mm')
        if g: d.line([(x0, py(.80)), (x0, py(.905))], fill=190, width=2)
    for j in range(0, 80, 10):
        pass
    d.line([(px(.035), py(.81)), (px(.965), py(.81))], fill=190, width=2)
    d.line([(px(.035), py(.905)), (px(.965), py(.905))], fill=190, width=2)
    fh = ImageFont.truetype(FONTB, 30)
    d.text((px(.08), py(.955)), 'VOLKSZÄHLUNG  17. MAI 1939', font=fh, fill=255, anchor='lm')
    d.text((px(.965), py(.955)), 'Haushaltungsliste · Lochkarte', font=fs, fill=220, anchor='rm')
    fn = ImageFont.truetype(FONT, 15)
    for j in range(80):
        d.text((px(.035 + (j + .5) * COLW), py(.07)), str(j + 1), font=fn, fill=170, anchor='mm')
    return Image.merge('RGBA', (img, img, img, img))


FACE = _face()


def _v(p): return 'vec2(%.7f,%.7f)' % tuple(p)


SRC = r'''#version 330
uniform vec2 u_res; uniform float u_time, u_weight;
uniform sampler2D u_face, u_ui;
uniform float u_zoom; uniform vec2 u_ctr, u_shake;
uniform float u_viewR, u_lit, u_backRed, u_mark, u_markPulse, u_flash, u_expand, u_ringsOn, u_spinR;
uniform float u_drum, u_drumRot, u_weaveOn, u_weave;
out vec4 fragColor;
#define PI 3.14159265
float h12(vec2 p){ vec3 p3=fract(vec3(p.xyx)*.1031); p3+=dot(p3,p3.yzx+33.33); return fract((p3.x+p3.y)*p3.z); }
float vn(vec2 p){ vec2 i=floor(p),f=fract(p); f=f*f*(3.-2.*f);
  return mix(mix(h12(i),h12(i+vec2(1,0)),f.x),mix(h12(i+vec2(0,1)),h12(i+vec2(1,1)),f.x),f.y); }
float fbm(vec2 p){ float s=0.,a=.5; for(int i=0;i<4;i++){ s+=a*vn(p); p=p*2.03+1.7; a*=.5; } return s; }
const float CW=%CW%, CH=%CH%, COLW=%COLW%, ROWH=%ROWH%;
const vec2 HOLEC=%HC%, HOLEH=%HH%;
const vec3 PAPER=vec3(.62,.56,.47), INK=vec3(.035,.03,.035), BLOOD=vec3(.9,.02,.03);
float PXw;
mat2 rot(float a){ float c=cos(a), s=sin(a); return mat2(c,s,-s,c); }
float sdRBox(vec2 p, vec2 b, float r){ vec2 q=abs(p)-b+r; return length(max(q,0.))+min(max(q.x,q.y),0.)-r; }

// one card. uv: 0..1 across, 0..1 up. id: which person. centre: the card we follow
vec4 card(vec2 uv, vec2 id, float centre){
  if(uv.x<0.||uv.x>1.||uv.y<0.||uv.y>1.) return vec4(0.);
  if(uv.x*CW/CH+(1.-uv.y)<.11) return vec4(0.);                      // the corner cut
  float pxu=PXw/CH;
  vec3 back=mix(vec3(1.,.82,.62),BLOOD,u_backRed)*2.2*(1.-u_lit);    // light behind the card
  vec3 paper=PAPER*(.92+.1*fbm(uv*vec2(14.,6.)+id*3.1));
  float ink=texture(u_face,uv).a;
  vec3 c=mix(paper,INK,ink*.85)*mix(.03,1.,u_lit);
  float edge=min(min(uv.x,1.-uv.x)*CW,min(uv.y,1.-uv.y)*CH);
  c*=.8+.2*smoothstep(0.,.004,edge);
  float cx=(uv.x-.035)/COLW, ry=(.80-uv.y)/ROWH;
  float col=floor(cx), row=floor(ry);
  if(col>=0.&&col<80.&&row>=0.&&row<12.){
    vec2 f=vec2(fract(cx)-.5,fract(ry)-.5)*vec2(COLW*CW/CH,ROWH);
    float d=sdRBox(f,vec2(.2*COLW*CW/CH,.3*ROWH),.07*COLW*CW/CH);
    float hole=1.-smoothstep(-pxu,pxu,d);
    float punched=step(h12(id*1.37+vec2(col*.71,3.)),.2)*step(abs(row-floor(h12(id+vec2(col*1.3,.5))*12.)),.1);
    float mark=step(abs(col-%MC%.),.1)*step(abs(row-%MR%.),.1)*u_mark;
    if(mark>0.){
      vec3 glow=BLOOD*(1.6+2.5*u_markPulse+2.*u_flash);
      return vec4(mix(c,glow,hole),1.);
    }
    if(punched>0.) return vec4(mix(c,back,hole),1.-hole*(1.-step(.001,length(back))));
  }
  return vec4(c,1.);
}

// the loom seen through the red hole: warp threads like bars; the weft weaves a red flower round a ring with a gap
vec3 weave(vec2 hl){
  float a=hl.x*40., b=hl.y*40.;
  float i=floor(a), j=floor(b);
  vec2 fr=vec2(fract(a),fract(b))-.5;
  vec2 cc=vec2(i+.5,j+.5)-vec2(0.,-.5);
  float rho=length(cc), ph=atan(cc.y,cc.x);
  float petal=step(rho,10.5+5.5*pow(abs(cos(2.5*ph+PI*.25)),.7))*step(4.6,rho);
  float gapd=abs(mod(ph+PI*.5+PI,2.*PI)-PI);
  float ring=step(abs(rho-3.),1.)*step(.55,gapd);
  float red=max(petal,ring);
  vec3 warpC=vec3(.82,.77,.68)*(.5+.5*sqrt(max(1.-4.*fr.x*fr.x,0.)));
  vec3 weftC=vec3(.8,.03,.05)*(.5+.5*sqrt(max(1.-4.*fr.y*fr.y,0.)));
  float warpS=smoothstep(.47,.34,abs(fr.x)), weftS=smoothstep(.47,.34,abs(fr.y));
  vec3 c=vec3(.004)+vec3(.03,0.,.002);
  if(j>=u_weave){ c=mix(c,warpC*.75,warpS); return c; }          // not yet woven: bars
  if(red<.5){ c=mix(c,weftC*.5,weftS); c=mix(c,warpC,warpS); }    // warp over
  else      { c=mix(c,warpC*.5,warpS); c=mix(c,weftC,weftS); }    // weft over
  return c;
}

void main(){
  vec2 uv=(gl_FragCoord.xy-.5*u_res)/u_res.y;
  PXw=1./(u_res.y*u_zoom);
  vec2 p=u_ctr+(uv+u_shake)/u_zoom;
  vec3 col=vec3(.004);
  float r=length(p), th=atan(p.y,p.x);
  // rings of cards: thousands of people
  if(u_ringsOn>0.){
    for(int k=1;k<=60;k++){
      float fk=float(k);
      float Rk=.12+.2*fk;
      float e=clamp(u_expand*1.8-(1.-fk/60.)*.8,0.,1.);
      float R=Rk*(1.+9.*e*e);
      if(abs(r-R)>CH*.9+.04*(1.+9.*e*e)) continue;
      float pop=smoothstep(Rk*.7,Rk*1.02,u_viewR);
      float alpha=pop*(1.-smoothstep(.5,.95,e))*u_ringsOn;
      if(alpha<=0.) continue;
      float N=floor(2.*PI*Rk/(CW+.04));
      float rk=(mod(fk,2.)*2.-1.)*(.012*u_time+u_spinR*e*e*(.6+.4*h12(vec2(fk,1.))));
      float dA=2.*PI/N;
      float j0=floor((th-rk)/dA+.5);
      for(int dj=-1;dj<=1;dj++){
        float j=j0+float(dj);
        float al=rk+j*dA;
        vec2 cc=R*vec2(cos(al),sin(al));
        float sc=max(pop,.001);
        vec2 l=rot(-(al-PI*.5))*(p-cc)/sc;
        vec4 cd=card(l/vec2(CW,CH)+.5,vec2(fk,mod(j,N)),0.);
        col=mix(col,cd.rgb,cd.a*alpha);
        col+=BLOOD*u_mark*alpha*(1.2+2.*u_flash)*exp(-length(l-HOLEC)/(PXw*1.8));   // the same hole in every card, seen from afar
      }
    }
  }
  // the drum: 24 cards come back round the centre, one missing
  if(u_drum>0.){
    float N=24., dA=2.*PI/N;
    float j0=floor((th-u_drumRot)/dA+.5);
    for(int dj=-1;dj<=1;dj++){
      float j=j0+float(dj), jm=mod(j,N);
      if(abs(jm-18.)<.1) continue;
      float ar=clamp(u_drum*1.7-h12(vec2(jm,4.))*.7,0.,1.); ar=1.-pow(1.-ar,3.);
      float R=mix(3.4,.62,ar);
      float al=u_drumRot+j*dA;
      vec2 cc=R*vec2(cos(al),sin(al));
      vec2 l=rot(-al)*(p-cc);
      vec4 cd=card(l/vec2(CW,CH)+.5,vec2(70.+jm,7.),0.);
      col=mix(col,cd.rgb,cd.a*step(.001,ar));
    }
  }
  // the card we follow
  vec4 cd=card(p/vec2(CW,CH)+.5,vec2(0.,0.),1.);
  col=mix(col,cd.rgb,cd.a);
  col+=BLOOD*u_mark*(1.+2.*u_markPulse)*exp(-length(p-HOLEC)/(PXw*2.2))*(1.-u_weaveOn);
  // inside the red hole: the loom
  if(u_weaveOn>0.){
    float d=sdRBox(p-HOLEC,HOLEH,.07*COLW*CW);
    float inH=1.-smoothstep(-PXw,PXw,d);
    col=mix(col,weave((p-HOLEC)/HOLEH.x),inH*u_weaveOn);
  }
  col+=vec3(1.,.9,.85)*u_flash*.1;
  vec4 ui=texture(u_ui,gl_FragCoord.xy/u_res);
  col=mix(col,ui.rgb,ui.a);
  fragColor=vec4(col*u_weight,1.);
}
'''
for k, v in {'%CW%': '%.4f' % CW, '%CH%': '%.4f' % CH, '%COLW%': '%.7f' % COLW, '%ROWH%': '%.7f' % ROWH,
             '%HC%': _v(HOLEC), '%HH%': _v(HOLEH), '%MC%': str(MARK[0]), '%MR%': str(MARK[1])}.items():
    SRC = SRC.replace(k, v)
POST = dict(u_bloom=.3, u_ca=.004)


def clamp(x, a=0., b=1.): return max(a, min(b, x))
def ease(x): x = clamp(x); return x * x * (3 - 2 * x)
def outc(x): x = clamp(x); return 1 - (1 - x) ** 3
def lerp(a, b, k): return a + (b - a) * k
def lz(a, b, k): return math.exp(lerp(math.log(a), math.log(b), k))


def camera(t):
    if t < T1: return lz(14., 4.2, outc((t - T0) / .6)), (0., 0.)
    if t < T3: return lz(4.2, .075, ease((t - T1) / (T2 - .05 - T1))), (0., 0.)
    if t < T4: return lz(.075, 3.2, ease((t - T3) / (T4 - .05 - T3))), (0., 0.)
    if t < T5: return 3.2 * (1 + .12 * math.exp(-max(t - T4, 0) * 10)), (0., 0.)
    if t < T8: return lz(3.2, .5, ease((t - T5) / .7)), (0., 0.)
    k = ease((t - T8) / 1.1)
    z = lz(.5, ZF, k)
    c = 1 - (.5 / z) * (1 - k)
    return z, (HOLEC[0] * c, HOLEC[1] * c)


def params(t):
    z, ctr = camera(t)
    sh = 0.
    for t0 in (T2, T4, T7):
        if 0 <= t - t0 < .3: sh += math.exp(-(t - t0) * 20) * .01
    spin_k = clamp((t - T6) / (2 * (T7 - T6)))
    return dict(u_zoom=z, u_ctr=ctr, u_shake=(sh * math.sin(t * 97), sh * math.cos(t * 83)),
                u_viewR=1.1 / z if t < T3 else 99., u_lit=ease((t - T0 - .3) / .35), u_backRed=1. - ease((t - T0 - .1) / .5),
                u_mark=1. if t >= T2 else 0., u_markPulse=math.exp(-max(t - T4, 0) * 5) * (t >= T4),
                u_flash=sum(math.exp(-(t - t0) * 14) for t0 in (T2, T4, T7) if t >= t0),
                u_expand=clamp((t - T3) / (T4 - .1 - T3)), u_ringsOn=1. if t < T4 else 0., u_spinR=3.,
                u_drum=clamp((t - T5 - .1) / .9) if t >= T5 else 0.,
                u_drumRot=2 * math.pi * 5 * ease(spin_k),
                u_weaveOn=ease((t - T8 - .75) / .3), u_weave=-23. + 46. * clamp((t - T9) / (TE - .35 - T9)))


# ---- the typed overlay: dates, quotes, the missing card's label
_UI = {}


def typed(s, t0, t, cps=38.):
    return s[:max(0, int((t - t0) * cps))] if t >= t0 else ''


def textures(t, w, h):
    s = h / 1080
    items = []
    date = ''
    if T0 + .7 <= t < T5: date = typed('17. V. 1939', T0 + .7, t)
    elif T5 <= t < T8: date = typed('13. II. 1930', T5 + .1, t)
    elif t >= T9: date = typed('1843', T9 + .1, t, 12)
    if date: items.append(((70, 60), date, 30, (226, 222, 212)))
    if T5 + .9 <= t < T8 + .2 and not (T6 + .05 < t < T7 + .45):
        items.append(((w / s / 2, 1000), 'C. M.  1911 - 1930', 22, (200, 196, 188), 'mm'))
    if T5 + .5 <= t < T8 + .3:
        q1 = typed('"...spirit is really eternally connected with matter..."', T5 + .5, t, 30)
        q2 = typed('A. M. Turing, Nature of Spirit, c. 1932', T6 - .3, t, 40)
        items.append(((70, 110), q1, 24, (226, 222, 212)))
        items.append(((70, 150), q2, 20, (170, 166, 158)))
    if t >= T9 + .35:
        q1 = typed('"...the Analytical Engine weaves algebraical patterns', T9 + .35, t, 34)
        q2 = typed(' just as the Jacquard-loom weaves flowers and leaves."', T9 + .35 + 53 / 34, t, 34)
        q3 = typed('A. A. Lovelace, 1843', TE - .55, t, 40)
        items.append(((70, 920), q1, 24, (236, 232, 222)))
        items.append(((70, 956), q2, 24, (236, 232, 222)))
        items.append(((70, 1000), q3, 20, (190, 186, 178)))
    key = (w, h, tuple((it[1], it[0]) for it in items))
    if key not in _UI:
        _UI.clear()
        img = Image.new('RGBA', (w, h), (0, 0, 0, 0)); d = ImageDraw.Draw(img)
        if t >= T9 + .35: d.rectangle([0, int(890 * s), int(1100 * s), h], fill=(4, 3, 3, 205))
        for it in items:
            (x, y), txt, size, colr = it[:4]
            f = ImageFont.truetype(FONT, int(size * s))
            d.text((x * s, y * s), txt, font=f, fill=colr + (255,), anchor=it[4] if len(it) > 4 else 'la')
        _UI[key] = img
    return {'u_face': FACE, 'u_ui': _UI[key]}
