"""s10 · 1:58.333–2:05.708  FRAGMENTS → DISHEARTENED (v2).
The terminal cursor becomes the gap ring. Around it a heptagon; on each corner a fragment of the journey.
Where the gap looks, the corner is cut off (corner cutting) and its fragment turns to sand; on FRAGMENTS the rest
go and the outline converges to a perfect, empty circle — the rounder, the more it has lost.
Behind: scrolling draft pages — Dickinson's "Heart, we will forget him" underneath, written over with the
arithmetic of π. The ring tries to close; a thrown pen streaks the page; a blade slashes "Heart"; the ring snaps open."""
import math
from pathlib import Path
from PIL import Image, ImageDraw, ImageFont

T3 = (Path(__file__).resolve().parents[2] / 'tests' / 't03_fragments' / 'scene.glsl').read_text(encoding='utf-8')
FRAG_GLSL = T3[T3.index('float gearSD('):T3.index('// dissolve into sand')]
FRAG_GLSL = FRAG_GLSL[:FRAG_GLSL.index('vec2 fragPos(int i)')]

SRC = r'''#version 330
uniform vec2 u_res; uniform float u_time, u_weight;
uniform float u_cursor, u_ringA, u_R, u_gap, u_half;
uniform vec2  u_poly[64]; uniform int u_n; uniform float u_polyA;
uniform vec2  u_fpos[7]; uniform float u_erase[7]; uniform float u_fragA;
uniform float u_scroll, u_overA, u_heartA, u_ink, u_slash, u_split, u_heart, u_snap;
uniform sampler2D u_under, u_over, u_word;
out vec4 fragColor;
#define PI 3.14159265
#define TAU 6.28318531
float PX;
float h12(vec2 p){ vec3 p3=fract(vec3(p.xyx)*.1031); p3+=dot(p3,p3.yzx+33.33); return fract((p3.x+p3.y)*p3.z); }
float vn(vec2 p){ vec2 i=floor(p),f=fract(p); f=f*f*(3.-2.*f);
  return mix(mix(h12(i),h12(i+vec2(1,0)),f.x),mix(h12(i+vec2(0,1)),h12(i+vec2(1,1)),f.x),f.y); }
float fbm(vec2 p){ float s=0.,a=.5; for(int i=0;i<4;i++){ s+=a*vn(p); p=p*2.03+1.7; a*=.5; } return s; }
mat2 rot(float a){ float c=cos(a),s=sin(a); return mat2(c,s,-s,c); }
float wrapA(float a){ return mod(a+PI,TAU)-PI; }
float sdSeg(vec2 p, vec2 a, vec2 b){ vec2 pa=p-a, ba=b-a; float h=clamp(dot(pa,ba)/max(dot(ba,ba),1e-9),0.,1.); return length(pa-ba*h); }
float sdCap(vec2 p, vec2 a, vec2 b, float ra, float rb){ vec2 pa=p-a, ba=b-a; float h=clamp(dot(pa,ba)/max(dot(ba,ba),1e-9),0.,1.); return length(pa-ba*h)-mix(ra,rb,h); }
float sdBox(vec2 p, vec2 b){ vec2 d=abs(p)-b; return length(max(d,0.))+min(max(d.x,d.y),0.); }
float line(float d, float w){ return 1.-smoothstep(w-PX,w+PX,d); }
''' + FRAG_GLSL + r'''
vec4 dissolving(int i, vec2 p){
  float e=u_erase[i];
  if(e>=1.) return vec4(0.);
  vec2 c=u_fpos[i]; float s=.05;
  vec2 q=(p-c)/s;
  if(length(q)>3.2) return vec4(0.);
  float n=vn(q*7.)*.6+vn(q*23.)*.4;
  float keep=smoothstep(e*1.25-.08,e*1.25,n);
  vec4 f=fragment(i,q)*keep;
  float edge=(1.-smoothstep(0.,.08,abs(n-e*1.25)))*step(.001,e);
  f.rgb+=vec3(1.,.9,.75)*edge*fragment(i,q).a*1.5;
  vec2 out_=normalize(c+vec2(1e-4));
  vec4 g=fragment(i,q-out_*e*1.5-vec2(vn(q*3.+7.)-.5,vn(q*3.+1.)-.5)*e*1.2);
  float grain=step(.8,h12(floor(p*u_res.y*.5)))*(1.-keep);
  f.rgb+=g.rgb*grain*(1.-e)*step(.001,e)*1.4;
  return f*u_fragA;
}
vec3 paper(vec2 uv){
  // the draft pages, split along the slash
  vec2 sd=normalize(vec2(1.,-.35));
  vec2 nn=vec2(-sd.y,sd.x);
  float side=sign(dot(uv-vec2(0.,-.4),nn));
  vec2 p=uv-nn*side*u_split*.03;
  vec3 c=vec3(.62,.5,.36)*(.55+.6*fbm(p*4.))*.085;
  vec2 tuv=vec2(p.x*.62+.5,fract(p.y*.62*.5+.5+u_scroll));
  float under=texture(u_under,tuv).a;
  float over=texture(u_over,tuv).a;
  c+=vec3(.55,.2,.12)*.085*under*(.35+.65*u_overA);
  c+=vec3(.86,.8,.68)*.13*over*u_overA;
  // the one word left: Heart
  vec2 wq=(p-vec2(0.,-.4))/vec2(.28,.07)*.5+.5;
  if(wq.x>0.&&wq.x<1.&&wq.y>0.&&wq.y<1.) c+=vec3(.7,.28,.16)*.5*texture(u_word,wq).a*u_heartA;
  // a pen thrown at the page
  if(u_ink>0.){
    vec2 a=vec2(-.75,.05), b=vec2(.55,-.55);
    float d=sdCap(p,a,mix(a,b,u_ink),.002,.012);
    float drops=0.; for(int k=0;k<14;k++){ float fk=float(k); vec2 dp=mix(a,b,h12(vec2(fk,3.)))+vec2(h12(vec2(fk,5.))-.5,h12(vec2(fk,7.))-.5)*.12;
      drops=max(drops,1.-smoothstep(.0,.004+.008*h12(vec2(fk,9.)),length(p-dp))*step(h12(vec2(fk,3.)),u_ink)); }
    c=mix(c,vec3(.01),max(1.-smoothstep(-PX,PX,d),drops)*.9);
  }
  // the slash and the split
  float cut=abs(dot(uv-vec2(0.,-.4),nn));
  c=mix(c,vec3(0.),(1.-smoothstep(u_split*.03-PX,u_split*.03+PX,cut))*step(.001,u_split));
  c+=vec3(.5,.42,.32)*.25*exp(-abs(cut-u_split*.03)*400.)*step(.001,u_split);
  c+=vec3(1.,.95,.9)*exp(-cut*900.)*u_slash*step(abs(dot(uv-vec2(0.,-.4),sd)),.5);
  vec2 pe=abs(uv)-vec2(.82,.48);
  return c*(1.-smoothstep(-.02,.01,max(pe.x,pe.y)));
}
void main(){
  vec2 uv=(gl_FragCoord.xy-.5*u_res)/u_res.y; PX=1./u_res.y;
  vec3 col=vec3(.003)+paper(uv)*u_polyA;
  // outer outline: heptagon, corners cut away, converging to a circle
  if(u_polyA>0.){
    float d=1e3;
    for(int i=0;i<64;i++){ if(i>=u_n) break; vec2 a=u_poly[i], b=u_poly[(i+1)%u_n]; d=min(d,sdSeg(uv,a,b)); }
    col+=vec3(.86,.8,.7)*(line(d,.0016)+.2*exp(-d*120.))*u_polyA;
  }
  for(int i=0;i<7;i++){ vec4 f=dissolving(i,uv); col=col*(1.-f.a)+f.rgb; }
  if(u_cursor>0.){ float d=sdBox(uv,vec2(.012,.022)); col+=vec3(.9)*(1.-smoothstep(-PX,PX,d))*u_cursor; }
  if(u_ringA>0.){
    float r=length(uv), a=atan(uv.y,uv.x), g=abs(wrapA(a-u_gap));
    vec2 e1=vec2(cos(u_gap+u_half),sin(u_gap+u_half))*u_R, e2=vec2(cos(u_gap-u_half),sin(u_gap-u_half))*u_R;
    float dr=g>u_half?abs(r-u_R):min(length(uv-e1),length(uv-e2));
    col=mix(col,vec3(.92,.91,.88),line(dr,.0085)*u_ringA);
    col+=vec3(1.,.95,.9)*exp(-max(dr-.0085,0.)*70.)*.25*u_ringA;
    col+=vec3(1.,.9,.8)*(exp(-length(uv-e1)*90.)+exp(-length(uv-e2)*90.))*u_snap*1.5;
    if(u_heart>0.){
      float x=uv.x/u_R; float y=.3*exp(-pow((x-.05)/.06,2.))-.12*exp(-pow((x+.05)/.05,2.))-.1*exp(-pow((x-.18)/.05,2.));
      float hd=max(abs(uv.y/u_R-y)*u_R,(abs(x)-.62)*u_R);
      col+=vec3(.5,1.,.7)*(line(hd,.0022)+exp(-hd*120.)*.4)*u_heart;
    }
  }
  fragColor=vec4(col*u_weight,1.);
}
'''
POST = dict(u_bloom=.5, u_ca=.004)
ERASE = [118.926, 119.158, 119.390, 119.617, 119.843, 120.307]
FRAG_T, TRY, NEAR, SNAP, END = 120.860, 121.677, 124.464, 124.890, 125.708
ORDER = [2, 5, 0, 4, 1, 6, 3]
RP = .36


def clamp(x, a=0., b=1.): return max(a, min(b, x))
def ease(x): x = clamp(x); return x * x * (3 - 2 * x)
def outc(x): x = clamp(x); return 1 - (1 - x) ** 3


def saccade(t, t0, a, b, dur=.07, over=.07):
    if t < t0: return a
    x = (t - t0) / dur
    if x < 1: return a + (b - a) * (1 + over) * outc(x)
    return b + (b - a) * over * (1 - ease((t - t0 - dur) / .14))


def corner_angle(i): return math.radians(90 + i * 360 / 7)


def polygon(t):
    """heptagon; corner k is cut when its beat comes; after FRAGMENTS, Chaikin iterations then a true circle"""
    V = [(RP * math.cos(corner_angle(i)), RP * math.sin(corner_angle(i))) for i in range(7)]
    cut_t = {ORDER[k]: ERASE[k] for k in range(6)}; cut_t[ORDER[6]] = FRAG_T
    pts = []
    for i in range(7):
        c = clamp((t - cut_t[i]) / .12) * .25
        if c <= 0: pts.append(V[i]); continue
        a, b, n = V[i - 1], V[i], V[(i + 1) % 7]
        pts.append((b[0] + (a[0] - b[0]) * c, b[1] + (a[1] - b[1]) * c))
        pts.append((b[0] + (n[0] - b[0]) * c, b[1] + (n[1] - b[1]) * c))
    iters = int(clamp((t - FRAG_T - .15) / .45) * 3 + .999) if t > FRAG_T + .15 else 0
    for _ in range(iters):
        q = []
        for i in range(len(pts)):
            a, b = pts[i], pts[(i + 1) % len(pts)]
            q.append((.75 * a[0] + .25 * b[0], .75 * a[1] + .25 * b[1])); q.append((.25 * a[0] + .75 * b[0], .25 * a[1] + .75 * b[1]))
        pts = q[:64]
    rnd = ease((t - FRAG_T - .6) / .4)
    if rnd > 0:
        n = 64
        circ = [(RP * .93 * math.cos(math.radians(90) + 2 * math.pi * k / n), RP * .93 * math.sin(math.radians(90) + 2 * math.pi * k / n)) for k in range(n)]
        # resample the current outline to 64 points by angle, then blend towards the circle
        def at(ang):
            best = min(pts, key=lambda p: abs(((math.atan2(p[1], p[0]) - ang + math.pi) % (2 * math.pi)) - math.pi))
            return best
        cur = [at(math.atan2(c[1], c[0])) for c in circ]
        pts = [(a[0] + (b[0] - a[0]) * rnd, a[1] + (b[1] - a[1]) * rnd) for a, b in zip(cur, circ)]
    return pts


def params(t):
    g = 0.
    for k, t0 in enumerate(ERASE):
        g = saccade(t, t0 - .12, g, math.degrees(corner_angle(ORDER[k])) % 360 if k == 0 else g + ((math.degrees(corner_angle(ORDER[k])) - g + 180) % 360 - 180))
    g = saccade(t, FRAG_T - .1, g, g + ((math.degrees(corner_angle(ORDER[6])) - g + 180) % 360 - 180))
    g = saccade(t, TRY - .2, g, g + ((-90 - g + 180) % 360 - 180), .12)
    erase = [0.] * 7
    for k, t0 in enumerate(ERASE): erase[ORDER[k]] = clamp((t - t0) / .5)
    erase[ORDER[6]] = clamp((t - FRAG_T) / .6)
    base = math.radians(27.); half = base
    if t > TRY:
        x = clamp((t - TRY) / (NEAR - TRY))
        half = base * (1 - .9 * (1 - (1 - x) ** 1.6)) + math.radians(1.2) * math.sin(t * 47.) * x
    if t > SNAP:
        y = t - SNAP; half = base + math.radians(9.) * math.exp(-y * 7.) * math.cos(y * 26.)
    heart = math.exp(-((t - (NEAR - .05)) / .12) ** 2) + .5 * math.exp(-((t - (NEAR + .33)) / .1) ** 2) if NEAR - .35 < t < SNAP + .05 else 0.
    pts = polygon(t)
    poly = pts + [(0., 0.)] * (64 - len(pts))
    fpos = [(RP * 1.15 * math.cos(corner_angle(i)), RP * 1.15 * math.sin(corner_angle(i))) for i in range(7)]
    scroll = 0.
    for k in range(200):                                   # integrate a slowing scroll
        tt = 118.3 + (t - 118.3) * (k + .5) / 200
        v = .09 * (1 - ease((tt - TRY) / (NEAR - TRY - .6)))
        scroll += v * (t - 118.3) / 200 if t > 118.3 else 0
    return dict(u_cursor=1 - ease((t - 118.33) / .25), u_ringA=ease((t - 118.36) / .3), u_R=.15 * (.3 + .7 * outc((t - 118.36) / .35)),
                u_gap=math.radians(g), u_half=half, u_poly=poly, u_n=len(pts), u_polyA=ease((t - 118.5) / .4),
                u_fpos=fpos, u_erase=erase, u_fragA=ease((t - 118.5) / .35),
                u_scroll=scroll, u_overA=ease((t - 118.6) / .8) * (1 - ease((t - 123.2) / 1.)), u_heartA=ease((t - 123.4) / .9),
                u_ink=outc((t - NEAR) / .09), u_slash=math.exp(-max(t - SNAP, 0) * 8) * (t >= SNAP),
                u_split=ease((t - SNAP - .03) / .3), u_heart=heart,
                u_snap=math.exp(-max(t - SNAP, 0) * 6) * (t > SNAP) + .4 * clamp((t - TRY) / (NEAR - TRY)) * (t < SNAP))


POEM = ['Heart, we will forget him,', 'You and I, tonight!', 'You may forget the warmth he gave,', 'I will forget the light.',
        'When you have done pray tell me,', 'That I my thoughts may dim;', "Haste! lest while you're lagging", 'I may remember him!']
_tex = {}


def _pages():
    if _tex: return _tex
    W, H = 1400, 2600
    under = Image.new('RGBA', (W, H), (0, 0, 0, 0)); du = ImageDraw.Draw(under)
    over = Image.new('RGBA', (W, H), (0, 0, 0, 0)); do = ImageDraw.Draw(over)
    fh = ImageFont.truetype('C:/Windows/Fonts/Inkfree.ttf', 58)
    fc = ImageFont.truetype('C:/Windows/Fonts/palai.ttf', 46)
    y = 60; k = 0
    while y < H - 80:                                          # the poem, drafted again and again, some lines struck out
        ln = POEM[k % len(POEM)]
        du.text((120 + (k * 37) % 90, y), ln, font=fh, fill=(255, 255, 255, 255))
        if k % 3 == 1:
            wdt = du.textlength(ln, font=fh)
            du.line((110 + (k * 37) % 90, y + 36, 130 + (k * 37) % 90 + wdt, y + 30), fill=(255, 255, 255, 255), width=5)
        y += 86; k += 1
    y = 30
    n = 7
    while y < H - 60:                                          # Archimedes' squeeze on pi, written over it
        lo = n * math.sin(math.pi / n); hi = n * math.tan(math.pi / n)
        do.text((260, y), f'n = {n:<6}  {lo:.7f}  <  π  <  {hi:.7f}', font=fc, fill=(255, 255, 255, 255))
        y += 64; n *= 2
        if n > 7 * 2 ** 16: n = 7
    word = Image.new('RGBA', (560, 140), (0, 0, 0, 0))
    ImageDraw.Draw(word).text((20, 0), 'Heart', font=ImageFont.truetype('C:/Windows/Fonts/Inkfree.ttf', 120), fill=(255, 255, 255, 255))
    _tex.update(u_under=under, u_over=over, u_word=word)
    return _tex


def textures(t, w, h): return _pages()
