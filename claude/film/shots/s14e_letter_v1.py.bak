"""s14e · 2:48.911–2:52.95  the seal, the letter.  (draft)  A detail view: the envelope face-on, flat, on the night sheet.

2:48.911 EXECUTION          cut on the beat: the red point is pressed into wax; the seal is the gapped ring, its gap down.
2:49.824 If I can have you back
                            the wax cracks down through the gap; the flap lifts; the letter comes out, the envelope goes;
                            the letter unfolds.  Turing to his mother, February 1930: "I feel sure that I shall meet Morcom
                            again somewhere and that there will be some work for us to do together" — only these words are
                            his; the rest of the page is handwriting too small to read.
2:51.868 I will run the     the page turns over: on the back, one red character, 爱; the writing shows through, reversed.
2:52.712 EXECUTION          the letter is taken out of the frame (to the slot of the room: next shot)."""
import math, random
from PIL import Image, ImageDraw, ImageFont

T_HIT, T_BACK, T_RUN, T_X = 168.911, 169.824, 171.868, 172.712
POST = dict(u_bloom=0., u_ca=0., u_grain=.012)
F = 'C:/Windows/Fonts/'


def clamp(x, a=0., b=1.): return a if x < a else b if x > b else x
def ease(x): x = clamp(x); return x * x * (3 - 2 * x)
def outc(x): x = clamp(x); return 1 - (1 - x) ** 3


SRC = r'''#version 330
uniform vec2 u_res; uniform float u_time, u_weight;
uniform float u_press, u_crack, u_flap, u_envY, u_letY, u_top, u_bot, u_flip, u_letX, u_zoom;
uniform vec2 u_shake;
uniform sampler2D u_front, u_back;
out vec4 fragColor;
const float PI = 3.14159265;
float h11(float p){ p = fract(p * .1031); p *= p + 33.33; p *= p + p; return fract(p); }
float h21(vec2 p){ vec3 p3 = fract(vec3(p.xyx) * .1031); p3 += dot(p3, p3.yzx + 33.33); return fract((p3.x + p3.y) * p3.z); }
float vn(vec2 p){ vec2 i = floor(p), f = fract(p); f = f * f * (3. - 2. * f);
  return mix(mix(h21(i), h21(i + vec2(1, 0)), f.x), mix(h21(i + vec2(0, 1)), h21(i + vec2(1, 1)), f.x), f.y); }
float fbm(vec2 p){ float a = .5, s = 0.; for(int i = 0; i < 4; i++){ s += a * vn(p); p = p * 2.03 + 7.1; a *= .5; } return s; }
vec3 srgb(float r, float g, float b){ return vec3(r, g, b) / 255.; }
vec3 untone(vec3 c, vec2 fc){
  vec3 L = pow(clamp(c, 0., .985), vec3(2.2));
  vec3 A = 2.51 - 2.43 * L, B = .03 - .59 * L, C = -.14 * L;
  vec3 y = (-B + sqrt(B * B - 4. * A * C)) / (2. * A);
  vec2 d = fc / u_res - .5;
  return y / 1.05 / (1. - .9 * dot(d, d));
}
float seg(vec2 p, vec2 a, vec2 b){ vec2 pa = p - a, ba = b - a; return length(pa - ba * clamp(dot(pa, ba) / dot(ba, ba), 0., 1.)); }
float aa(float d, float w){ return 1. - smoothstep(w * .5, w * 1.5, d); }

const vec2 EH = vec2(.55, .3875);              // the envelope, half size (C6)
const vec2 APEX = vec2(0., -.05);             // where the flap's point meets the seal
const float LW = .32, PH = .15;              // the letter: half width, half a panel's height (three panels)

vec3 PAPER, INK, CREAM, WAX, NIGHT;

// the envelope's body with its back folds; inside shows once the flap is up
vec4 envBody(vec2 p, float px){
  if(abs(p.x) > EH.x || abs(p.y) > EH.y) return vec4(0.);
  vec3 c = CREAM * (.97 + .045 * fbm(p * 40.));
  float l = 0.;
  l = max(l, aa(seg(p, vec2(-EH.x, -EH.y), vec2(-.08, -.08)), px * 1.2) * .6);
  l = max(l, aa(seg(p, vec2(EH.x, -EH.y), vec2(.08, -.08)), px * 1.2) * .6);
  // the opening: when the flap is up, the pocket's mouth is a shade darker
  float open = smoothstep(.5, 1.6, u_flap);
  float mouth = step(p.y, EH.y) * step(EH.y - (EH.y - APEX.y) * (1. - abs(p.x) / EH.x), p.y);
  c = mix(c, c * .8, mouth * open);
  c = mix(c, INK, l);
  float edge = min(EH.x - abs(p.x), EH.y - abs(p.y));
  c = mix(c, INK, aa(edge, px * 1.6));
  return vec4(c, 1.);
}
// the flap: a triangle from the top corners to the apex, turning over its hinge (the top edge)
vec4 flap(vec2 p, float px, out float onTop){
  float ct = cos(u_flap);                        // 1 closed, -1 laid open above
  float ay = EH.y - (EH.y - APEX.y) * ct;
  onTop = step(0., ct);
  // triangle (hinge corners, projected apex)
  vec2 a = vec2(-EH.x, EH.y), b = vec2(EH.x, EH.y), c = vec2(0., ay);
  float s = (ct >= 0.) ? 1. : -1.;
  float t = (EH.y - p.y) / max(EH.y - ay, 1e-4);
  if(ct < 0.) t = (p.y - EH.y) / max(ay - EH.y, 1e-4);
  float halfw = EH.x * (1. - t);
  if(t < 0. || t > 1. || abs(p.x) > halfw) return vec4(0.);
  vec3 col = CREAM * (ct >= 0. ? .99 : .9) * (.97 + .04 * fbm(p * 40. + 3.));
  float e = min(halfw - abs(p.x), min(t, 1. - t) * abs(EH.y - ay)) ;
  col = mix(col, INK, aa(e, px * 1.6));
  return vec4(col, 1.);
}
// the seal: pressed wax, the gapped ring in relief; after the crack each half keeps its side
vec4 seal(vec2 p, vec2 at, float half_, float px){
  vec2 q = p - at;
  if(half_ > 0. && q.y < -.0 + .003 * sin(q.x * 300.)) return vec4(0.);   // the upper half (goes with the flap)
  if(half_ < 0. && q.y > .0 + .003 * sin(q.x * 300.)) return vec4(0.);
  float r = length(q);
  float R = mix(.006, .082, u_press) * (1. + .06 * (fbm(q * 60.) - .5) + .04 * sin(atan(q.y, q.x) * 7.));
  if(r > R) return vec4(0.);
  vec3 c = WAX * (.9 + .2 * fbm(q * 90.));
  c *= mix(1., .7, smoothstep(R * .75, R, r));                              // the rolled rim
  // the imprint: a ring with its gap down, in relief (lit from the upper left)
  float ri = .044, w = .0075;
  float ang = atan(q.x, -q.y);
  float gap = smoothstep(.36, .48, abs(ang));
  float dr = r - ri;
  float ring = (1. - smoothstep(w * .7, w, abs(dr))) * gap * u_press;
  vec2 nrm = normalize(q + 1e-5) * sign(dr);
  float lit = dot(nrm, normalize(vec2(-1., 1.)));
  c = mix(c, c * (1. + .55 * lit), ring);
  c = mix(c, c * .75, (1. - smoothstep(.02, .026, r)) * u_press);            // the pressed centre
  c = mix(c, c * 1.35, pow(max(1. - length(q - vec2(-.025, .03)) / .02, 0.), 2.) * .5);   // a gleam
  return vec4(c, 1.);
}

// the letter: three panels; the top and bottom ones fold over the middle; it can turn over
vec3 page(vec2 uv, bool back){
  // uv in [0,1]^2 over the open page
  vec3 c = PAPER * (.97 + .04 * fbm(uv * vec2(30., 42.)));
  if(!back){
    float ink = texture(u_front, uv).a;
    c = mix(c, INK, ink * .9);
  } else {
    float thru = texture(u_front, uv).a;                                  // the writing shows through (uv is already turned over)
    c = mix(c, INK, thru * .07);
    float red = texture(u_back, uv).a;
    c = mix(c, srgb(178., 24., 30.), red * .92);
  }
  // the creases
  c *= 1. - .08 * (1. - smoothstep(0., .004, abs(uv.y - 1. / 3.))) - .08 * (1. - smoothstep(0., .004, abs(uv.y - 2. / 3.)));
  return c;
}
vec4 letter(vec2 p, float px){
  p.x -= u_letX; p.y -= u_letY;
  p /= u_zoom;
  // turning over: about the vertical axis
  float xs = cos(PI * u_flip);
  if(abs(xs) < .01) return vec4(0.);
  bool back = xs < 0.;
  float x = p.x / abs(xs);
  if(abs(x) > LW) return vec4(0.);
  float u = back ? .5 - x / (2. * LW) : .5 + x / (2. * LW);
  vec3 col = vec3(0.); float a = 0.;
  // middle panel (flat): y in [-PH, PH]
  if(abs(p.y) <= PH){ col = page(vec2(u, .5 + p.y / (6. * PH)), back); a = 1.; }
  // bottom panel, hinge at -PH; angle 0 = folded up over the middle, PI = open below
  float cb = cos(u_bot);
  if(cb > 0.){ float s = (p.y + PH) / max(cb, 1e-3); if(s >= 0. && s <= 2. * PH){ col = PAPER * .9 * (.97 + .03 * fbm(p * 40.)); a = 1.; } }
  else { float s = (-PH - p.y) / max(-cb, 1e-3); if(s >= 0. && s <= 2. * PH){ col = page(vec2(u, (2. * PH - s) / (6. * PH)), back); a = 1.; } }
  // top panel, hinge at +PH
  float ctp = cos(u_top);
  if(ctp > 0.){ float s = (PH - p.y) / max(ctp, 1e-3); if(s >= 0. && s <= 2. * PH){ col = PAPER * .94 * (.97 + .03 * fbm(p * 40. + 5.)); a = 1.; } }
  else { float s = (p.y - PH) / max(-ctp, 1e-3); if(s >= 0. && s <= 2. * PH){ col = page(vec2(u, (4. * PH + s) / (6. * PH)), back); a = 1.; } }
  if(a > 0.){
    // the outline of the sheet
    float ex = LW * abs(xs) - abs(p.x);
    col = mix(col, INK * 1.5, aa(ex / u_zoom, px * 1.3) * .6);
  }
  return vec4(col, a);
}

void main(){
  float s1 = h11(u_time * 1731.7 + .13), s2 = h11(u_time * 911.3 + .71);
  vec2 fc = gl_FragCoord.xy + vec2(s1, s2) - .5;
  vec2 p = (fc - .5 * u_res) / u_res.y + u_shake;
  float px = 1. / u_res.y;
  PAPER = srgb(246., 241., 229.); INK = srgb(38., 30., 24.); CREAM = srgb(242., 235., 219.); WAX = srgb(150., 18., 24.);
  NIGHT = srgb(13., 12., 11.);
  vec3 col = NIGHT * (1. + .05 * (fbm(fc * .05 / (u_res.y / 1080.)) - .5));
  // a faint drafting frame: the detail view
  vec2 fr = abs(p) - vec2(.84, .46);
  col = mix(col, srgb(200., 196., 186.), aa(abs(max(fr.x, fr.y)), px * 1.2) * .35);

  vec2 pe = p - vec2(0., u_envY);
  float onTop;
  vec4 F = flap(pe, px, onTop);
  vec4 B = envBody(pe, px);
  vec4 Lt = letter(p, px);
  bool leaving = u_envY < -.001;                                 // the envelope is going: the letter lies on top
  if(onTop < .5 && F.a > 0.) col = F.rgb;                        // the flap laid open, above the hinge
  if(!leaving && u_letY > .001 && Lt.a > 0.) col = Lt.rgb;       // coming out from behind the body
  if(B.a > 0.) col = B.rgb;
  if(onTop > .5 && F.a > 0.) col = F.rgb;
  // the seal: whole; cracked, its upper half goes with the flap
  if(u_press > 0.){
    float ct = cos(u_flap);
    vec2 at = APEX + vec2(0., u_envY);
    if(u_crack <= 0.){ vec4 S = seal(p, at, 0., px); if(S.a > 0.) col = S.rgb; }
    else {
      vec4 S = seal(p, at + vec2(.004, -.002), -1., px); if(S.a > 0.) col = S.rgb;
      vec2 up = vec2(-.004, EH.y - (EH.y - APEX.y) * ct + u_envY);
      if(ct > -.2){ vec4 S2 = seal(p, up, 1., px); if(S2.a > 0.) col = S2.rgb; }
    }
  }
  if(leaving && Lt.a > 0.) col = Lt.rgb;
  if(any(isnan(col))) col = NIGHT;
  fragColor = vec4(untone(col, gl_FragCoord.xy) * u_weight, 1.);
}
'''


def params(t):
    press = outc((t - T_HIT) / .06) if t >= T_HIT else 0.
    k = t - T_HIT
    shake = (0., 0.)
    if 0 <= k < .07:
        r = random.Random(int(t * 60))
        shake = (r.uniform(-1, 1) * .006, r.uniform(-1, 1) * .006)
    crack = 1. if t >= T_BACK else 0.
    flap = math.pi * ease((t - T_BACK - .05) / .28)
    letY = .45 * ease((t - 170.1) / .35) - .45 * ease((t - 170.4) / .25)
    envY = -1.9 * ease((t - 170.4) / .28)
    top = math.pi * ease((t - 170.62) / .18)
    bot = math.pi * ease((t - 170.8) / .18)
    flip = ease((t - T_RUN) / .34)
    letX = 1.9 * ease((t - T_X) / .3)
    zoom = 1. + .06 * ease((t - 170.98) / .9) - .06 * ease((t - T_RUN) / .3)
    return dict(u_press=press, u_shake=shake, u_crack=crack, u_flap=flap, u_envY=envY, u_letY=letY,
                u_top=top, u_bot=bot, u_flip=flip, u_letX=letX, u_zoom=zoom)


# ---- the page: his words, the rest as handwriting too small to read
def _scribble(d, x0, y, x1, r, w=3):
    x = x0
    pts = []
    while x < x1:
        wl = r.uniform(30, 90)
        for i in range(int(wl / 3)):
            xx = x + i * 3
            pts.append((xx, y + 7 * math.sin(xx * .33 + r.uniform(0, .4)) * r.uniform(.4, 1.) - (6 if r.random() < .06 else 0)))
        d.line(pts, fill=(255, 255, 255, 235), width=w); pts = []
        x += wl + r.uniform(12, 22)


def _front():
    W, H = 1400, 1970
    img = Image.new('RGBA', (W, H), (0, 0, 0, 0)); d = ImageDraw.Draw(img)
    r = random.Random(1930)
    f = ImageFont.truetype(F + 'segoesc.ttf', 56); fd = ImageFont.truetype(F + 'segoesc.ttf', 40)
    d.text((W - 110, 120), '16. II. 1930', font=fd, fill=(255, 255, 255, 240), anchor='rm')
    y = 250
    for i in range(7): _scribble(d, 110 + (60 if i == 0 else 0), y, W - 120 - r.uniform(0, 300) * (i == 6), r); y += 78
    y += 20
    for ln in ['I feel sure that I shall meet', 'Morcom again somewhere and', 'that there will be some work', 'for us to do together']:
        d.text((130, y), ln, font=f, fill=(255, 255, 255, 250)); y += 96
    y += 30
    for i in range(8): _scribble(d, 110, y, W - 120 - r.uniform(0, 400) * (i == 7), r); y += 78
    return img


def _back():
    W, H = 1400, 1970
    img = Image.new('RGBA', (W, H), (0, 0, 0, 0)); d = ImageDraw.Draw(img)
    f = ImageFont.truetype(F + 'STXINGKA.TTF', 620)
    d.text((W / 2, H * .5), '爱', font=f, fill=(255, 255, 255, 255), anchor='mm')
    return img


_TX = {}


def textures(t, w, h):
    if not _TX:
        _TX['f'] = _front(); _TX['b'] = _back()
    return {'u_front': _TX['f'], 'u_back': _TX['b']}
