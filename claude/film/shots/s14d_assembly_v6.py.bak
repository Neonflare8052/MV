"""s14d · 2:41.70–2:46.4  (replaces the black after s13, and s14's opening; draft)

2:41.70           s13's blood fills the screen.  It goes back into the paper like ink, toward one point; under it the sheet
                  of the Analytical Engine was there all along, faint.  The point slides to the centre.
2:42.32           the music lifts: the margins are inked in.
2:42.632 If I can / 2:43.315 give them all the
                  the parts fall into place round the red point, one group a beat: base, hopper, barrel and gears,
                  bed and brushes, pockets, the store columns.  The point ends in a card's hole.
2:45.166 EXECUTION   (v4) the Engine, finished, holds through the word.
2:45.77           night: the paper goes black, the ink lime white; Babbage's words give way to the rules for using it;
                  the title is struck out and stamped; every card's hole is red; the counter over pocket 4 runs to
                  041377; over the point an eye opens, its gap turned down into the light it throws on the machine.
2:46.016 Then I can
                  the drawing closes in on the point.

The machine, the sheet and the camera are t11's (tests/t11_assembly)."""
import sys, math, importlib.util
from pathlib import Path
import numpy as np

_D = Path(__file__).resolve().parent
_T11 = _D.parents[1] / 'tests' / 't11_assembly'
sys.path.insert(0, str(_T11))
import drafting
_sp = importlib.util.spec_from_file_location('t11r', _T11 / 'render.py'); T11 = importlib.util.module_from_spec(_sp); _sp.loader.exec_module(T11)

SRC = (_D / 's14d_assembly.glsl').read_text(encoding='utf-8')
POST = dict(u_bloom=0., u_ca=0., u_grain=.012)

G0, B = 162.74, 60 / 130                                     # v6: the true grid from 2:42.74 (130 bpm, measured on the audio)
T_IN, X = 161.70, 165.166                                    # v6: back to the old scheme: the sorter (night) on EXECUTION, as soon as the last parts land
T_EYE = X + .2                                               # the eye opens .2 s after the switch (165.97 crowded it with the train)
LAND = [G0 + k * B for k in range(6)]                        # one group of parts a beat
DROP_T, DROP_H = .17, 120.
HOLE = (7., 10.34, 0.)                                       # world position of the envelope's point (its flap meets the centre)
SCALE0 = 74.
DOT0 = (.445, .5)                                            # where s13's red disc was, as a fraction of the frame
COUNT = 41377
SCALE_END = 7.5
PUSH = 999.                                                  # it holds on the night a moment, then closes in
FAC = T_EYE + .26                                            # the eye is open: the factories rise (as in v4: eye, then .26 s)

# v5: the train.  2:46.24 its nose comes in from the left, close, a silhouette across the lower half; 2:46.47 the
# camera looks up after its steam; 2:46.94 the steam fills the frame (the desk comes out of it).
T_TRAIN, T_TILT, T_FULL = G0 + 7.5 * B, G0 + 8 * B, G0 + 9 * B   # 166.20 (an eighth), 166.43, 166.89
TR_V, TR_TOP, TR_H = 3000., 540., 600.                       # its speed (units/s), its top, its height (1080 units)
NEAR = 1.6                                                   # it is near: it moves more than the sheet when the camera tilts
TILT = .55                                                   # how far the camera looks up (frames)


def tilt(t):
    return TILT * ease((t - T_TILT) / (T_FULL - T_TILT)) ** 1.3


def nose(t):
    return -60. + TR_V * (t - T_TRAIN)


def puffs(t):
    """the steam: puffs born at the chimney as it passes; they rise, spread, are dragged a little after it"""
    out = []
    sh = tilt(t) * 1080. * NEAR
    tb = T_TRAIN
    while tb <= t and len(out) < 40:
        cx = nose(tb) - TRAIN_CHIM
        if cx > -250:
            age = t - tb
            x = cx + 380. * (1 - math.exp(-age / .25)) - 120. * age
            y = TR_TOP - 10. - 760. * (1 - math.exp(-age / .45)) + sh
            r = 60. + 820. * (1 - math.exp(-age / .55))
            out.append((x, y, r, .95))
        tb += 1 / 42.
    return out + [(0., 0., 0., 0.)] * (40 - len(out))


def clamp(x, a=0., b=1.): return a if x < a else b if x > b else x
def ease(x): x = clamp(x); return x * x * (3 - 2 * x)
def outc(x): x = clamp(x); return 1 - (1 - x) ** 3


def drop(t, land):
    if t < land - DROP_T: return 1e4
    if t < land:
        s = (t - land + DROP_T) / DROP_T
        return DROP_H * (1 - s) ** 2
    return -.6 * math.sin(math.pi * clamp((t - land) / .12))  # it lands, and settles


def scale(t):
    return SCALE0 * math.exp(math.log(SCALE_END / SCALE0) * ease((t - PUSH) / (168.911 - PUSH))) if t > PUSH else SCALE0


_CAM = {}


def cam(w, h, sc):
    c = T11.Cam(w, h, c=HOLE, scale=sc)
    return c


def params(t):
    W, H = 1920., 1080.                                      # u_dot is set in pixels in main() via u_res; here in 1080p then scaled
    sc = scale(t)
    c = cam(1920, 1080, sc)
    k = ease((t - T_IN - .02) / .8)
    dot = ((DOT0[0] + (.5 - DOT0[0]) * k), .5)
    rec = 2300. * (1 - outc((t - T_IN - .02) / .9)) + 0.
    n = int(round(COUNT * outc((t - X - .01) / .6))) if t >= X else 0
    digits = f'{n:06d}'
    return dict(c.uniforms(),
                u_drop=[float(drop(t, L)) for L in LAND],
                u_dotF=dot, u_recF=rec, u_stain=1. - ease((t - 162.2) / .6),
                u_dotA=1.,
                u_ghost=.16 + .84 * ease((t - 162.32) / .3),
                u_q=1., u_notes=ease((t - 164.7) / .4), u_sw=1. if t >= X else 0.,
                u_strike=1. if t >= X else 0., u_stamp=1. if t >= X else 0., u_man=1. if t >= X else 0.,
                u_inv=1. if t >= X else 0., u_eye=outc((t - T_EYE) / .22), u_cone=ease((t - T_EYE - .08) / .3),
                u_z=SCALE0 / sc, u_fac=outc((t - FAC) / .35), u_smk=t - FAC,
                u_exec=1. if t >= X else 0., u_cnt=tuple(float(ch) for ch in digits),
                u_chim=[(float(a), float(b)) for a, b in (CH + [(-9., -9.)] * 12)[:12]],
                u_tilt=tilt(t), u_trainA=1. if t >= T_TRAIN - .02 else 0.,
                u_trainR=(nose(t) - TRAIN_L, TR_TOP, TRAIN_L, TR_H), u_near=tilt(t) * 1080. * NEAR,
                u_fog=ease((t - (T_FULL - .32)) / .32) ** 1.4 if t < T_FULL else 1., u_puff=puffs(t))


_TX = {}
CH = []
_sp2 = importlib.util.spec_from_file_location('s14src_d', _D / 's14_cards.py'); _S14 = importlib.util.module_from_spec(_sp2); _sp2.loader.exec_module(_S14)
S14FACE = _S14.FACE


def eye_glyphs():
    """'<' and '>' in the code font, a ring's width apart: the ring itself is drawn in the shader."""
    from PIL import Image, ImageDraw, ImageFont
    W, H = 990, 330
    img = Image.new('RGBA', (W, H), (0, 0, 0, 0)); d = ImageDraw.Draw(img)
    f = ImageFont.truetype('C:/Windows/Fonts/CascadiaMono.ttf', 300)
    for ch, x in (('<', W * .27), ('>', W * .73)):
        d.text((x, H * .5), ch, font=f, fill=(255, 255, 255, 255), anchor='mm')
    return img


def train_img():
    """a steam locomotive, its tender and three cars, side on: only a silhouette (drawn nose left, then turned)"""
    from PIL import Image, ImageDraw
    k = .5 * 2                                                # px per unit, drawn twice as big, then brought down
    L, H = TRAIN_L, TR_H
    img = Image.new('L', (int(L * k), int(H * k)), 0); d = ImageDraw.Draw(img)
    R = lambda x0, y0, x1, y1: d.rectangle([x0 * k, y0 * k, x1 * k, y1 * k], fill=255)
    E = lambda x0, y0, x1, y1: d.ellipse([x0 * k, y0 * k, x1 * k, y1 * k], fill=255)
    C = lambda x, y, r: E(x - r, y - r, x + r, y + r)
    o = 40.
    R(o + 0, 380, o + 70, 430); R(o - 30, 390, o + 5, 420)                       # buffer beam, buffer
    d.rounded_rectangle([(o + 40) * k, 110 * k, (o + 210) * k, 360 * k], radius=30 * k, fill=255)   # smokebox
    R(o + 245, 20, o + 315, 130); R(o + 228, 0, o + 332, 34)                    # chimney
    R(o + 190, 130, o + 1150, 352); E(o + 150, 130, o + 240, 352)               # boiler
    E(o + 560, 70, o + 720, 175); E(o + 880, 96, o + 960, 150)                  # dome, valves
    R(o + 20, 350, o + 1520, 400)                                               # running board
    R(o + 280, 380, o + 520, 470)                                               # cylinder
    R(o + 1130, 45, o + 1520, 430); R(o + 1110, 25, o + 1545, 60)              # cab, roof
    d.rectangle([(o + 1225) * k, 115 * k, (o + 1335) * k, 215 * k], fill=0)    # its window: the one opening
    for x, r, y in ((720, 152, 440), (1040, 152, 440), (330, 92, 500), (500, 92, 500)): C(o + x, y, r)
    R(o + 1520, 400, o + 1560, 420)
    R(o + 1560, 150, o + 2280, 470); E(o + 1600, 100, o + 2240, 200)            # tender, coal
    for x in (1680, 1920, 2160): C(o + x, 512, 80)
    for i in range(3):                                                          # three cars: no windows, no doors
        x0 = o + 2320 + i * 1540
        R(x0 - 40, 400, x0, 420)
        R(x0, 100, x0 + 1500, 470); E(x0 - 10, 50, x0 + 1510, 150)
        for x in (180, 380, 1120, 1320): C(x0 + x, 512, 76)
    R(-200, 586, L + 200, 600)                                                  # the rail
    img = img.transpose(Image.FLIP_LEFT_RIGHT).resize((int(L * .5), int(H * .5)), Image.LANCZOS)
    out = Image.new('RGBA', img.size, (255, 255, 255, 0)); out.putalpha(img)
    return out


TRAIN_L = 40. + 2320. + 3 * 1540. + 40.
TRAIN_CHIM = 40. + 280.                                      # the chimney, from the nose


def textures(t, w, h):
    if (w, h) not in _TX:
        _TX.clear()
        L = drafting.draw_layers(cam(w, h, SCALE0), w, h)
        CH[:] = [(x / (w * 1080 / h), 1. - y / 1080.) for x, y in drafting.CHIMNEYS][:12]
        _TX[(w, h)] = {'u_train': train_img(), 'u_odo': T11.odo_atlas(), 'u_col': T11.col_atlas(), 'u_face': S14FACE, 'u_eyeG': eye_glyphs(),
                       'u_Lfn': L['frame_n'], 'u_Lnn': L['notes_n'], 'u_Lfac': L['factory'],
                       'u_Lf': L['frame'], 'u_Lq': L['quotes'], 'u_Lt': L['title'], 'u_Ln': L['notes'],
                       'u_Ls': L['strike'], 'u_Lp': L['stamp'], 'u_Lm': L['manual']}
    return _TX[(w, h)]
